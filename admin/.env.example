# Copy to .env.local for local development.
#
# Vite inlines every VITE_* value into the JavaScript bundle, where anyone can
# read it. Put URLs and public identifiers here, never a secret.

# The API this build talks to. `make up` in cbpupsis-api serves this portal's app,
# api-admin, on :8003 (and starts this client too, already pointed at it). A single
# `uvicorn main:app` process serves every app on :8000 instead.
VITE_API_BASE_URL=http://localhost:8003/api/v1
