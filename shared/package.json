{
  "name": "@cbpupsis/shared",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-free code every CBPUPSIS client app uses: the API client, error envelope, session store, and generated API types.",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./api": "./src/api/index.ts",
    "./auth": "./src/auth/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "gen:api": "npx --yes openapi-typescript@7.13.0 http://localhost:8000/openapi.json -o src/api/schema.gen.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
