# Copy to .env.local for local development.
#
# Vite inlines every VITE_* value into the JavaScript bundle, where anyone can
# read it. Put URLs and public identifiers here, never a secret.

# The API this build talks to. `make up` in cbpupsis-api serves this portal's app,
# api-student, on :8001 (and starts this client too, already pointed at it). A single
# `uvicorn main:app` process serves every app on :8000 instead.
VITE_API_BASE_URL=http://localhost:8001/api/v1

# Optional frontend-only connection attempt when the backend reports enabled=false.
# This permits the authorization request; backend OAuth setup is still required.
# Leave false for normal deployments. Set true in .env.development.local to try it.
VITE_GOOGLE_CALENDAR_ALLOW_CONNECT_ATTEMPT=false
